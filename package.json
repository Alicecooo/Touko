{
  "name": "touko",
  "private": true,
  "version": "0.1.115",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/Alicecooo/Touko",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alicecooo/Touko.git"
  },
  "author": {
    "name": "Milind Soni",
    "email": "46266943+milind-soni@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "desktopName": "com.openmausbot.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean-build-output.mjs",
    "lint": "oxlint --deny-warnings . && node tests/checks/source-conventions.check.mjs",
    "check:contrast": "node tests/checks/skin-contrast.check.mjs",
    "i18n:check": "node tests/checks/translations.check.mjs",
    "dev": "vite",
    "omb": "node --experimental-strip-types server/openmausbot.ts",
    "dev:server": "node --experimental-strip-types server/dev-server.ts",
    "mcp": "node --experimental-strip-types scripts/dev/developer-mcp-server.ts",
    "dev:isolated": "node --experimental-strip-types scripts/dev/isolated-environment.ts",
    "eval": "node --experimental-strip-types evals/runners/run-evals.ts",
    "dev:desktop": "electron .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run && node --test \"electron/*.node-test.mjs\"",
    "test:electron": "node --test \"electron/*.node-test.mjs\"",
    "bench:observation": "node --experimental-strip-types scripts/benchmarks/benchmark-observation.ts",
    "bench:persistence": "node --experimental-strip-types scripts/benchmarks/benchmark-persistence.ts",
    "test:watch": "vitest",
    "check:desktop-control-container": "node tests/checks/desktop-control-container.check.mjs",
    "check:electron-syntax": "node tests/checks/electron-module-syntax.check.mjs",
    "preview": "vite preview",
    "generate:avatar-shapes": "node --experimental-strip-types scripts/generators/generate-avatar-shapes.ts",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/build/bundle-server.mjs",
    "prepare:windows-desktop-control": "node scripts/setup/prepare-windows-desktop-control.mjs",
    "check:windows-desktop-control": "node tests/checks/windows-desktop-control.check.mjs",
    "prepare:https-tunnel": "node scripts/setup/prepare-https-tunnel.mjs",
    "prepare:duckdb": "node scripts/setup/prepare-duckdb-runtime.mjs",
    "prepare:linux-desktop-control": "node scripts/setup/prepare-linux-desktop-control.mjs",
    "prepare:linux-desktop-control:offline": "node scripts/setup/prepare-linux-desktop-control.mjs --offline",
    "build:updater": "node scripts/build/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:updater && pnpm prepare:https-tunnel && pnpm prepare:duckdb",
    "package:win": "pnpm package:prepare && pnpm prepare:windows-desktop-control && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && pnpm prepare:linux-desktop-control && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm package:prepare && pnpm prepare:linux-desktop-control:offline && electron-builder --linux --x64 --publish never",
    "check:deb-command": "node tests/checks/deb-command.check.mjs",
    "check:linux-update": "xvfb-run -a electron --no-sandbox tests/checks/linux-update.check.mjs",
    "check:linux-package": "node tests/checks/run-linux-package-checks.check.mjs",
    "check:linux-desktop-input": "node tests/checks/linux-desktop-input.check.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm prepare:linux-desktop-control && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:win",
    "test:packaged-server": "node tests/checks/packaged-server.check.mjs",
    "test:e2e": "vitest run tests/e2e",
    "test:evals": "vitest run --config evals/vitest.config.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:scripts && pnpm typecheck:tests && pnpm typecheck:evals",
    "check:model-catalog": "node tests/checks/model-catalog.check.mjs",
    "generate:translations": "node scripts/generators/generate-translations.mjs",
    "test:server:unit": "vitest run server --exclude \"tests/**\" --exclude \"src/**\" --exclude \"electron/**\" --exclude \"shared/**\"",
    "test:server": "vitest run tests/server"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@clack/prompts": "1.7.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@duckdb/node-api": "1.5.6-r.1",
    "@lezer/highlight": "1.2.5",
    "@muse-code/sdk": "1.4.6",
    "@novnc/novnc": "1.7.0",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@trycua/cua-driver": "0.28.2",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "croner": "10.0.1",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "lucide-react": "^0.539.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.1.0",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.415.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "tldts": "7.4.18",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "vega-themes": "3.0.0",
    "ws": "8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.2",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
